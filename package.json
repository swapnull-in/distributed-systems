{
  "name": "distributed-systems",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learn distributed systems in TypeScript — write skew, CAP, Raft, fencing, 2PC vs Saga, retry storms, CRDTs, clocks, and a multi-region static-stability drill.",
