    "phase3": "node src/phase3/raft.ts",
    "phase4": "node src/phase4/fencing.ts",
    "phase5": "node src/phase5/2pc-vs-saga.ts",
    "phase6": "node src/phase6/retry-storm.ts",
    "phase7": "node src/phase7/crdt.ts",
    "phase8": "node src/phase8/clocks.ts",
    "phase9": "node src/phase9/session-guarantees.ts",
    "phase10": "node src/phase10/outbox.ts",
    "phase11": "node src/phase11/hlc.ts",
    "phase12": "node src/phase12/quorum-read-repair.ts",
    "phase13": "node src/phase13/bulkheads.ts",
    "phase14": "node src/phase14/durable-execution.ts",
    "phase15": "node src/phase15/mutual-match.ts",
    "capstone": "node src/capstone/multi-region.ts",
    "web": "node web/serve.mjs",
    "dashboard": "node web/serve.mjs",
    "deploy": "npx wrangler pages deploy web --project-name distributed-systems",
    "typecheck": "tsc --noEmit"
